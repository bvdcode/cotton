{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Kestrel": {
    "Limits": {
      "MaxConcurrentConnections": 1024,
      "MaxConcurrentUpgradedConnections": 512
    }
  },
  "RequestAdmission": {
    "GlobalConcurrentRequestLimit": 256,
    "GlobalQueueLimit": 256,
    "ClientConcurrentRequestLimit": 32,
    "ClientQueueLimit": 32
  },
  "ResourceConcurrency": {
    "HlsTranscodes": 2,
    "HlsProbes": 2,
    "ArchiveStreams": 4
  },
  "AllowedHosts": "*"
}
