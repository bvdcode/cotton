{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Kestrel": {
    "Limits": {
      "MaxConcurrentConnections": 1024,
      "MaxConcurrentUpgradedConnections": 512
    }
  },
  "RequestAdmission": {
    "GlobalConcurrentRequestLimit": 256,
    "ClientConcurrentRequestLimit": 32
  },
  "AllowedHosts": "*"
}
