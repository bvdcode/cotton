{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Kestrel": {
    "Limits": {
      "MaxConcurrentConnections": 1024,
      "MaxConcurrentUpgradedConnections": 512
    }
  },
  "ResourceConcurrency": {
    "HlsTranscodes": 2,
    "HlsProbes": 2,
    "ArchiveStreams": 4,
    "StorageWrites": 8
  },
  "AllowedHosts": "*"
}
